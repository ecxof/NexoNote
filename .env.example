# Hugging Face API token for the in-note AI assistant
# (Explain This / Summarize / Quiz Me).
#
# Get one at: https://huggingface.co/settings/tokens
# Copy this file to .env and fill in the value.
#
# Optional: without it the rest of the app works normally and only the
# AI assistant is unavailable.
VITE_HF_API_TOKEN=
